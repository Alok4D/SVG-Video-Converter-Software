{
  "name": "svgtovideoconverter",
  "version": "0.1.0",
  "description": "SVG Video Converter Desktop Application",
  "author": "Developer",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build:remotion": "node scripts/bundle-remotion.mjs",
    "build": "npm run build:remotion && npx next build",
    "start": "npx next start",
    "prod": "NODE_ENV=production npx tsx server.ts",
    "lint": "npx eslint",
    "electron:dev": "npx concurrently \"npm run dev\" \"npx cross-env ELECTRON_START_URL=http://localhost:3000 npx electron .\"",
    "electron:build": "npm run build:remotion && npx next build && npx electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@remotion/bundler": "^4.0.512",
    "@remotion/renderer": "^4.0.512",
    "bullmq": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^6.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.3",
    "next": "16.3.1",
    "puppeteer": "^25.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "^4.0.512",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.svgtovideoconverter.desktop",
    "productName": "SVG Video Converter",
    "icon": "public/logo.png",
    "electronVersion": "34.0.0",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@remotion/**/*",
      "node_modules/@remotion/compositor-win32-x64-msvc/**/*",
      "**/*.dll",
      "**/*.exe",
      "node_modules/@esbuild/**/*",
      "node_modules/esbuild/**/*",
      "src/lib/video/remotion/**/*",
      "remotion-build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "remotion-build/**/*",
      ".next/**/*",
      "server.js",
      "server.ts",
      "package.json"
    ],
    "win": {
      "icon": "public/logo.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
